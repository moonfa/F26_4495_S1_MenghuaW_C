DATABASE_URL=sqlite:///./workbench.db
OPENBB_PROVIDER=yfinance
AI_PROVIDER=mock            # mock | gemini
AI_MODEL=                   # a Gemini model id you have access to
GEMINI_API_KEY=
AI_THINKING_BUDGET=1024     # tokens the model may spend "thinking"; 0 = off; off = do not send
AI_MODEL_BASELINE=          # optional: a stronger model used only for first-time baselines
